{
  "name": "@versu/plugin-maven",
  "version": "2.0.2",
  "description": "Versu Maven Plugin",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json --outDir dist",
    "test": "vitest --passWithNoTests",
    "test:coverage": "vitest --coverage --passWithNoTests",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "versu",
    "plugin",
    "maven",
    "semantic-versioning",
    "conventional-commits",
    "version-engine",
    "dependency-cascade",
    "monorepo"
  ],
  "author": "tvcsantos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/versuhq/plugin-maven.git"
  },
  "bugs": {
    "url": "https://github.com/versuhq/plugin-maven/issues"
  },
  "homepage": "https://github.com/versuhq/plugin-maven#readme",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "fast-xml-parser": "^5.9.3"
  },
  "peerDependencies": {
    "@versu/core": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/semver": "^7.7.1",
    "@versu/core": "^3.1.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
